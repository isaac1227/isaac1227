# Valores compartidos de desarrollo
APP_ENV=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me-in-local-env

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=profile_dev
POSTGRES_USER=profile_user
POSTGRES_PASSWORD=profile_password
DATABASE_URL=postgresql://profile_user:profile_password@postgres:5432/profile_dev

# MongoDB
MONGO_INITDB_ROOT_USERNAME=profile_user
MONGO_INITDB_ROOT_PASSWORD=profile_password
MONGODB_URI=mongodb://profile_user:profile_password@mongo:27017
